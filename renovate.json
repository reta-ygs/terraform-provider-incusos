{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": true,
  "minimumReleaseAge": "1 day",
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Require Dependency Dashboard approval for major updates; auto-open PRs for non-major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major Terraform Plugin Framework & Testing updates",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^github\\.com/hashicorp/terraform-/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "terraform-plugin-framework"
    },
    {
      "description": "Group non-major Incus / IncusOS updates",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^github\\.com/lxc/incus/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "incus-os"
    },
    {
      "description": "Group remaining non-major Go module updates",
      "matchManagers": [
        "gomod"
      ],
      "excludePackageNames": [
        "/^github\\.com/hashicorp/terraform-/",
        "/^github\\.com/lxc/incus/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "go non-major dependencies"
    }
  ]
}
